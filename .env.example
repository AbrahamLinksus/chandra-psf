NEXT_PUBLIC_DEALER_PHONE=+91 44 0000 0000
# Phase 2 (server). Placeholders only; real values live in Vercel and your own .env.local.
DATABASE_URL=pglite:./.pglite
DATABASE_URL_UNPOOLED=
CRON_SECRET=replace-with-32-plus-random-chars
IP_HASH_PEPPER=replace-with-32-random-bytes-base64
APP_URL=http://localhost:8000
# Live-refresh poll interval in seconds (default 30; invalid or <= 0 falls back to 30)
NEXT_PUBLIC_POLL_SECONDS=30
NEXT_PUBLIC_COMPANY_NAME=Your Company Name
NEXT_PUBLIC_PRIVACY_PHONE=+91 00 0000 0000
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
# Optional: set to 1 to log argon2 hash/verify timing to stderr (off when unset)
AUTH_HASH_TIMING=
